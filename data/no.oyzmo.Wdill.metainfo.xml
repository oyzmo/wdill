<component type="desktop-application">
  <id>no.oyzmo.Wdill</id>

  <!-- The licence of wdill itself, and of this metadata file. This is where
       GNOME Software and the Flatpak tooling read the licensing from, so it
       must stay in step with LICENSE and Cargo.toml's `license` field. -->
  <project_license>GPL-3.0-or-later</project_license>
  <metadata_license>CC0-1.0</metadata_license>

  <name>wdill</name>
  <summary>Tiny 3D print file viewer</summary>
  <developer id="no.oyzmo">
    <name>oyzmo</name>
  </developer>

  <description>
    <p>
      What does it look like? wdill opens 3D print files and shows you the
      model: STL (binary and ASCII), 3MF, OBJ, STEP, GLB and FBX.
    </p>
    <p>
      Files load on a background thread with a progress bar, so large models
      never freeze the window, and rendering is a multithreaded software
      rasterizer — meshes with hundreds of thousands of triangles rotate
      smoothly with no GPU driver requirements.
    </p>
  </description>

  <!-- GPLv3 §6(d): the corresponding source is offered from the same place as
       the binaries, as wdill-<version>-src.zip. -->
  <url type="homepage">http://oyzmo.no/</url>

  <launchable type="desktop-id">no.oyzmo.Wdill.desktop</launchable>
  <content_rating type="oars-1.1"/>

  <categories>
    <category>Graphics</category>
    <category>Viewer</category>
  </categories>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>

  <!-- Written by bump.sh, never by hand: Cargo.toml stays the one place the
       version is set. GNOME Software shows these notes with each update. -->
  <releases>
    <release version="0.4.2" date="2026-10-26">
      <description>
        <p>Build scripts stop when the Flatpak signing key is missing, and find the Flatpak site from the desktop too</p>
      </description>
    </release>
    <release version="0.4.1" date="2026-10-26">
      <description>
        <p>Flatpak installs now get updates from flatpak.oyzmo.no, also in GNOME Software</p>
      </description>
    </release>
  </releases>
</component>
