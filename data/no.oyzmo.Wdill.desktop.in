[Desktop Entry]
Type=Application
Name=wdill
GenericName=3D Print File Viewer
Comment=What does it look like? A tiny viewer for STL, 3MF, OBJ, STEP, GLB and FBX files
Exec=@BINDIR@/wdill %f
Icon=no.oyzmo.Wdill
Terminal=false
Categories=Graphics;Viewer;GTK;GNOME;
MimeType=model/stl;model/x-stl-ascii;model/x-stl-binary;application/sla;model/3mf;application/vnd.ms-3mfdocument;model/obj;model/step;application/step;application/x-step;model/step+xml;model/gltf-binary;application/vnd.autodesk.fbx;
StartupNotify=true
